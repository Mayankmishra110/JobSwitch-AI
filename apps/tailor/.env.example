# Copy to .env for local development. Never commit .env.
#
# This service is stateless - no DATABASE_URL of any kind belongs here,
# same boundary as services/ai (see specs/architecture.md).

PORT=8200
HOST=0.0.0.0

# Bound to the internal network only in real deployment. Left unset, the
# internal-token check is skipped entirely (see src/auth.ts) - fine for
# local dev, never fine for a real deploy where this service is reachable
# from anywhere but services/ai's Graph A caller.
INTERNAL_TOKEN=

# The LaTeX engine invoked for /v1/compile. `pdflatex` and `xelatex`
# (MiKTeX/TeX Live) share the same CLI flags this service passes and are
# both verified locally. D-30 picks `tectonic` for the production image
# (smaller, arm64-friendly, self-contained) - that is a real, separate gap:
# tectonic's CLI is genuinely different (no -interaction/-output-directory
# flags the way pdflatex/xelatex have them), so swapping this value to
# "tectonic" would NOT work without also changing how the process is
# invoked. Not done yet - named here rather than implied to just work.
LATEX_ENGINE=pdflatex
