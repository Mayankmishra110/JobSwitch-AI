# Copy to .env for local development. Never commit .env.

NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Application connection. Must be a role that has been GRANTed app_web -
# NOT the owner role, or RLS will be bypassed and tenant isolation silently
# stops applying.
DATABASE_URL=postgres://app_web_local:changeme@127.0.0.1:5432/jobswitch_dev
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# Migration connection. Needs DDL rights, which the running app must not have.
DATABASE_URL_MIGRATE=postgres://jobswitch:devpassword@127.0.0.1:5432/jobswitch_dev

APP_ORIGIN=http://localhost:3000

# 32+ characters. Generate with: openssl rand -base64 48
# Rotating this signs everyone out, which is the intended response to a
# suspected compromise.
SESSION_SECRET=replace-me-with-at-least-32-random-characters
SESSION_TTL_SECONDS=1209600
SESSION_COOKIE_NAME=js_session
PASSWORD_RESET_TTL_SECONDS=3600

# Google OAuth is optional. All three or none - a partial set disables it.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# `log` prints reset links to stdout. Correct for development, never for
# production - a real provider is wired up in Phase 8.
MAIL_TRANSPORT=log

# Set true only when running behind a proxy that sets X-Forwarded-For.
# Enabling it without such a proxy lets clients spoof their own IP and evade
# rate limits.
TRUST_PROXY=false

RATE_LIMIT_ENABLED=true
