# Copy to .env for local development. Never commit .env.
#
# This service is stateless - no DATABASE_URL of any kind belongs here.
# See specs/architecture.md's boundary note: services/ai never touches
# Postgres, by design.

# Bound to the internal network only in real deployment. Left unset, the
# internal-token check is skipped entirely (see app/auth.py) - fine for
# local dev, never fine for a real deploy where this service is reachable
# from anywhere but services/matcher and apps/tailor.
INTERNAL_TOKEN=

# Provider waterfall - first key set wins, same order and same behavior as
# Mayankbuilt's nipun pipeline. NONE of these have real values checked in
# anywhere; without at least one, /v1/match/explain returns 503.
GROQ_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# LLM_MODEL=   # optional override; provider-specific default otherwise
